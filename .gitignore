# Output generated by the pipeline (contains case-specific data and PII)
output/

# Case data (PII, generated reports)
cases/

# OpenCode / omo session data
.omo/

# Shell scripts with potentially hardcoded secrets
run_*.sh

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
package-lock.json

# Wrangler
.wrangler/

# Playwright
e2e-report/
test-results/
playwright-report/
.dev.vars

# Cloudflare
.wrangler/state/

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp

# Presentations (generated, large)
presentacion/

# Backups
_backups/

# Symlink targets (motor compartido)
