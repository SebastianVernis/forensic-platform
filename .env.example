# Copiar a .env y ajustar valores
# LLM local (recomendado para privacidad)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=not-needed-for-local

# LLM cloud (Ollama Cloud subscription)
OLLAMA_CLOUD_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=tu-api-key-cloud-aqui

# Modelos
MODELO_RAPIDO=llama3.1:latest
MODELO_PROFUNDO=llama3.1:latest
MODELO_CLOUD=kimi-k2.7-code:cloud

# Timeout LLM en segundos
LLM_TIMEOUT=600
LLM_TIMEOUT_CLOUD=180

# Retry
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=2.0

# Corpus
INPUT_DIR=/opt/lebaron/L3B4_txt_raw
OUTPUT_DIR=/opt/lebaron/output

# Chunking (más conservador para modelo 8B local)
CHUNK_SIZE=60000
CHUNK_OVERLAP=5000

# OCR
OCR_DPI=300
OCR_LANG=spa

# Entidades a seudonimizar
ENTIDADES_A_SEUDONIMIZAR=PERSONA,VEHICULO

# Tomos a incluir (vacío = todos)
TOMOS_INCLUIDOS=
